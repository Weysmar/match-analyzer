# Copy to .env for development. Never commit .env. In production, secrets are set in Dokploy.
# The values below are local development placeholders, not secrets.

APP_ENV=development
# The site's public address, the base of the OAuth redirects.
SITE_URL=http://localhost:3000
LOG_LEVEL=INFO

# --- PostgreSQL (compose.dev.yaml)
POSTGRES_USER=ma_dev
POSTGRES_PASSWORD=ma_dev
POSTGRES_DB=match_analyzer
DEV_POSTGRES_PORT=5432
# Migrations: owns the schema. `ma-db upgrade` also sets the two passwords below.
DATABASE_URL=postgresql://ma_dev:ma_dev@127.0.0.1:5432/match_analyzer
API_DB_PASSWORD=ma_api_dev
WORKER_DB_PASSWORD=ma_worker_dev
# The API and the worker connect with roles restricted to what they need.
API_DATABASE_URL=postgresql://ma_api:ma_api_dev@127.0.0.1:5432/match_analyzer
WORKER_DATABASE_URL=postgresql://ma_worker:ma_worker_dev@127.0.0.1:5432/match_analyzer
# `just test-db` creates its temporary databases from this connection.
TEST_DATABASE_URL=postgresql://ma_dev:ma_dev@127.0.0.1:5432/postgres

# --- Sessions
# Signs the OAuth nonce cookie. Required outside development: `openssl rand -hex 32`.
SESSION_SECRET=
SESSION_TTL_DAYS=30
ANON_SESSION_TTL_DAYS=30

# --- Object store (S3 emulator in development, Cloudflare R2 in production)
DEV_S3_PORT=9000
S3_ENDPOINT=http://127.0.0.1:9000
# The host browsers see, used in presigned URLs.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# `auto` on R2.
S3_REGION=us-east-1
S3_BUCKET=match-analyzer-dev
S3_ACCESS_KEY_ID=ma-dev-access-key
S3_SECRET_ACCESS_KEY=ma-dev-secret-key

# --- Uploads
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_FILES_PER_BATCH=50
UPLOAD_URL_TTL_S=600

# --- Rate limits
RATE_UPLOAD_ANON_PER_DAY=100
RATE_UPLOAD_IP_PER_DAY=200
RATE_UPLOAD_USER_PER_DAY=500
RATE_AUTH_IP_PER_MIN=20
# How many proxies to trust when reading the client's address.
TRUSTED_PROXY_COUNT=1

# --- Epic sign-in, off until the Brand Review passes
FEATURE_EPIC_LOGIN=false
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_REDIRECT_URI=

# --- Parser
PARSER_BIN=rl-parse
PARSER_TIMEOUT_S=30
PARSER_MEMORY_MB=512
# Optional cap; empty keeps every frame of the replay.
PARSER_MAX_FPS=
WORKER_CONCURRENCY=1
# How long a running job may last before it counts as abandoned
WORKER_JOB_TIMEOUT_S=600

# --- Retention
RAW_RETENTION_DAYS=30
RAW_RETENTION_HEADER_ONLY_DAYS=180

# --- Legal pages (never in the code)
OPERATOR_NAME=
OPERATOR_EMAIL=
HOSTING_INFO=
