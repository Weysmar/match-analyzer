# Placeholders for the production stack's check (.github/compose.ci.yaml): not secrets, never used
# outside the CI and a workstation. Production sets its own in Dokploy (docs/operations.md).
IMAGE_TAG=ci
SITE_URL=https://match-analyzer.invalid
POSTGRES_PASSWORD=ci-owner-password
API_DB_PASSWORD=ci-api-password
WORKER_DB_PASSWORD=ci-worker-password
SESSION_SECRET=ci-session-secret-of-at-least-32-characters
S3_ENDPOINT=http://s3:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=match-analyzer-ci
S3_ACCESS_KEY_ID=ci-access-key
S3_SECRET_ACCESS_KEY=ci-secret-key
# The emulator has one key: in production, the backups' token is another one.
BACKUP_S3_BUCKET=match-analyzer-ci-backups
BACKUP_S3_ACCESS_KEY_ID=ci-access-key
BACKUP_S3_SECRET_ACCESS_KEY=ci-secret-key
